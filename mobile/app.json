{
  "expo": {
    "name": "Civickit",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/ckLogocolorwbg.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logos/ckLogocolorwbg.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logos/ckLogocolorwbg.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "org.civickit.civickit",
      "softwareKeyboardLayoutMode": "adjustPan",
      "googleServicesFile": "./google-services.json"
    },
    "scheme": "civickit",
    "web": {
      "favicon": "./assets/favicon.ico"
    },
    "plugins": [
      [
        "expo-asset",
        "react-native-map-link"
      ],
      "expo-secure-store",
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "04adaf2a-cfdc-4d44-b87b-c6eceac919a5"
      }
    }
  }
}