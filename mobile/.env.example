# Copy to mobile/.env.local if you need to override the API URL.
# .env.local is gitignored.
#
# You normally do NOT need this file. In development the API base URL is
# derived from whatever address Metro is served on, which is the machine
# running the backend — that covers both supported setups:
#
#   npm start             phone and laptop on the same wifi
#   npm run start:tailscale   any network, via Tailscale
#
# Set this only to point the app at a deployed backend. Required for release
# builds, which have no Metro host to derive from.
#
# EXPO_PUBLIC_API_URL=https://civickit.org/api

# Port used when deriving the dev URL from the Metro host. Defaults to 3000.
# Only applies when EXPO_PUBLIC_API_URL is unset.
# EXPO_PUBLIC_API_PORT=3000

# Stand in for the device's GPS during development. The seeded issues are in
# Midtown St. Louis, so working from anywhere else shows an empty map and no
# way to exercise the nearby-issues flow.
#
# Both must be set together. Ignored outside development, so these can never
# move real users. Copy to mobile/.env.local, which is gitignored.
#
# EXPO_PUBLIC_DEV_LAT=38.63965
# EXPO_PUBLIC_DEV_LNG=-90.23581
