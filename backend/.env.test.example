# Copy to .env.test.local to override the integration-test database.
#
# The default is civickit_test on the docker-compose database, which is created
# on demand. You only need this file to point the tests somewhere else.
#
# This MUST NOT be the database DATABASE_URL uses: integration tests drop the
# schema on startup and TRUNCATE every table between cases. The harness compares
# the two and refuses to run if they match.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/civickit_test"
